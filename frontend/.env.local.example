# Copy to .env.local
# Local development: the browser calls the API directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Same-origin mode (what Render uses): the browser calls this frontend, which forwards /api/v1 and /media.
# NEXT_PUBLIC_API_BASE_URL=/
# API_PROXY_URL=http://127.0.0.1:8000      # or API_HOST=<api hostname> (https is assumed)
