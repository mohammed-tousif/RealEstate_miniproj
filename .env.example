# Copy to .env (repo root) and adjust. Never commit the real .env.

APP_ENV=development
# SQLite (zero-install default) is used when DATABASE_URL is not set.
# PostgreSQL via docker-compose:
# DATABASE_URL=postgresql+psycopg://propwise:propwise@localhost:5432/propwise

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=120

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_PROPERTY=10

# Keep false: no authorised document-verification process exists in this prototype.
DOCUMENT_VERIFICATION_PROCESS_ENABLED=false

# Password given to the demo accounts created by scripts/seed_db.py
SEED_DEMO_PASSWORD=DemoPass123

# Assistant (optional). Without a key the Chat page runs in the labelled Basic search mode.
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOOL_ROUNDS=5
AI_RATE_LIMIT_PER_MINUTE=12

# Failed logins allowed per minute for one client and email
LOGIN_FAILURES_PER_MINUTE=10
# Set true only behind a proxy you control (Render): rate limits then use X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For the same-origin proxy used on Render: NEXT_PUBLIC_API_BASE_URL=/ and API_PROXY_URL=http://127.0.0.1:8000
